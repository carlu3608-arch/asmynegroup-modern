# MongoDB connection (set in Railway, never commit the real value)
MONGODB_URI=
MONGODB_DB=asmyne

# Auth / sessions (required for login + admin). Use a long random string.
JWT_SECRET=

# Admin seed (used to create/sync the admin account on first login).
# Never hardcode these in source — set them as Railway env vars only.
ADMIN_EMAIL=admin@asmyne.com
ADMIN_PASSWORD=

# Payments / AI (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
